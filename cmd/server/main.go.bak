package main

import (
	"net/http"

	"github.com/gin-gonic/gin"
)

func main() {
	r := gin.Default()

	r.GET("/health", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{"status": "ok"})
	})

	// placeholder route - generated server will mount more handlers here
	// e.g. api.RegisterHandlers(r, &MyHandlers{})

	r.Run(":8080")
}
