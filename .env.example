APP_NAME=homework-api
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8081
APP_SHUTDOWN_TIMEOUT_SECONDS=10

HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_TIMEOUT_SECONDS=30

LOG_FILE_PATH=logs/app.log

DB_DRIVER=postgres
# Use DB_HOST=auto to support Windows PowerShell and WSL with PostgreSQL installed on Windows.
DB_HOST=auto
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600
